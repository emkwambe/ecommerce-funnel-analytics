# .env.example: names and descriptions only. NEVER put real values here.
# analysis/tests/test_env_drift.py keeps this list equal to the environment variables the code reads.

# Required for `python -m funnel.ingest` only (a provenance event, run rarely).
# Kaggle API token, created at https://www.kaggle.com/settings (API section). Store it in the
# Windows user environment; funnel.ingest copies it into its own process and never prints it.
KAGGLE_API_TOKEN=

# Optional, non-secret overrides. Each has a default in the code and is normally left unset.

# Repository root passed to dbt. Set automatically by `python -m funnel.build`; the dbt
# profile falls back to C:/Dev/ecommerce-funnel-analytics.
FUNNEL_REPO_ROOT=
# Base URL for `npm --prefix web run smoke`. Default: the production domain.
SMOKE_URL=
# Base URL for `npm --prefix web run screenshots`. Default: the production domain.
SCREENSHOT_URL=
# Evidence set name for screenshots (the folder under ai-workflow/evidence/). Default: sprint-1.
SCREENSHOT_SET=
# Folder for full-resolution screenshots (gitignored). Default: ai-workflow/evidence/full/<set>.
SCREENSHOT_OUT=
# Set to 0 to skip writing compressed WebP copies. Default: write them.
SCREENSHOT_WEBP=
# Comma-separated page paths to capture. Default: every page.
SCREENSHOT_PAGES=
