# Python
analysis/.venv/
# Exploratory outputs are never committed; only the scripts are (analysis/tests/test_explore_outputs.py).
analysis/explore/*
!analysis/explore/*.py
__pycache__/
.pytest_cache/
*.egg-info/

# Data (raw, parquet, warehouse) is never committed. Anchored to the repo root: an
# unanchored "data/" also matched web/public/data/, the committed JSON exports.
/data/

# Web
web/node_modules/
web/.next/
web/.vercel/

# dbt
pipeline/target/
pipeline/logs/

# Secrets and environment files. .env.example holds names only and is committed
# (analysis/tests/test_env_drift.py checks it is not ignored).
.env*
!.env.example
kaggle.json

# Full-resolution evidence images (commit only downsized copies)
ai-workflow/evidence/**/*-full.png
ai-workflow/evidence/**/*-full.jpg
ai-workflow/evidence/**/full/
